NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://jobsai:jobsai@localhost:5432/jobsai

# Use 46630 and the Robinhood Chain testnet RPC for development; use 4663 for mainnet.
RH_CHAIN_ID=46630
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
USDG_TOKEN_ADDRESS=
USDG_DECIMALS=6
RH_CONFIRMATIONS=2

AUTH_DOMAIN=www.tryjobsai.com
AUTH_URI=https://www.tryjobsai.com
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
GAS_WALLET_PRIVATE_KEY=replace-with-0x-and-64-hex-private-key
TEAM_WALLET_ADDRESSES=
CRON_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=1
