NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://jobsai:jobsai@localhost:5432/jobsai

# Use 46630 and the Robinhood Chain testnet RPC for development; use 4663 for mainnet.
RH_CHAIN_ID=46630
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
USDG_TOKEN_ADDRESS=
USDG_DECIMALS=6
RH_CONFIRMATIONS=2
MAX_ACTIVE_CLAIMS_PER_WALLET=2
CLAIM_EXPIRY_HOURS=24
PAUSE_NEW_WORK=false
MIN_JOB_ETH_AMOUNT=0.001
MIN_JOB_USDG_AMOUNT=1

AUTH_DOMAIN=www.tryjobsai.com
AUTH_URI=https://www.tryjobsai.com
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-a-different-32-character-secret
JOBSAI_TEAM_PASSWORD=replace-with-at-least-32-random-characters
GAS_WALLET_PRIVATE_KEY=replace-with-0x-and-64-hex-private-key
GAS_WALLET_MIN_BALANCE_WEI=5000000000000000
GAS_TX_REPLACEMENT_AFTER_SECONDS=600
TEAM_WALLET_ADDRESSES=
CRON_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY=1
OPS_ALERT_WEBHOOK_URL=

# Optional image uploads for job submissions. Videos should be shared as cloud-storage links.
CLOUDINARY_URL=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

# Optional one-sentence job drafting. Leave GROQ_API_KEY empty to hide drafting behind a 503.
GROQ_API_KEY=
JOB_DRAFT_MODEL=llama-3.3-70b-versatile
