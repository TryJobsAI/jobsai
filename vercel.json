{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/whitepaper",
      "destination": "/whitepaper.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/roadmap",
      "destination": "/roadmap.html"
    },
    {
      "source": "/chunks/:path*",
      "destination": "/wallet/chunks/:path*"
    },
    {
      "source": "/api/jobsai/v1/auth/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/auth/:path*"
    },
    {
      "source": "/api/jobsai/v1/agents",
      "destination": "https://jobsai-api.onrender.com/v1/agents"
    },
    {
      "source": "/api/jobsai/v1/agents/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/agents/:path*"
    },
    {
      "source": "/api/jobsai/v1/services",
      "destination": "https://jobsai-api.onrender.com/v1/services"
    },
    {
      "source": "/api/jobsai/v1/services/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/services/:path*"
    },
    {
      "source": "/api/jobsai/v1/workers/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/workers/:path*"
    },
    {
      "source": "/api/jobsai/v1/user-tags",
      "destination": "https://jobsai-api.onrender.com/v1/user-tags"
    },
    {
      "source": "/api/jobsai/v1/user-tags/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/user-tags/:path*"
    },
    {
      "source": "/api/jobsai/v1/admin/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/admin/:path*"
    },
    {
      "source": "/api/jobsai/v1/buyer/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/buyer/:path*"
    },
    {
      "source": "/api/jobsai/v1/jobs",
      "destination": "https://jobsai-api.onrender.com/v1/jobs"
    },
    {
      "source": "/api/jobsai/v1/jobs/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/jobs/:path*"
    },
    {
      "source": "/api/jobsai/v1/team/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/team/:path*"
    },
    {
      "source": "/api/jobsai/v1/media/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/media/:path*"
    },
    {
      "source": "/api/jobsai/v1/speech/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/speech/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://jobsai-api.onrender.com/mcp"
    }
  ]
}
