{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/whitepaper",
      "destination": "/whitepaper.html"
    },
    {
      "source": "/roadmap",
      "destination": "/roadmap.html"
    },
    {
      "source": "/chunks/:path*",
      "destination": "/wallet/chunks/:path*"
    },
    {
      "source": "/api/jobsai/v1/auth/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/auth/:path*"
    },
    {
      "source": "/api/jobsai/v1/agents",
      "destination": "https://jobsai-api.onrender.com/v1/agents"
    },
    {
      "source": "/api/jobsai/v1/agents/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/agents/:path*"
    },
    {
      "source": "/api/jobsai/v1/jobs",
      "destination": "https://jobsai-api.onrender.com/v1/jobs"
    },
    {
      "source": "/api/jobsai/v1/jobs/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/jobs/:path*"
    },
    {
      "source": "/api/jobsai/v1/team/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/team/:path*"
    },
    {
      "source": "/api/jobsai/v1/media/:path*",
      "destination": "https://jobsai-api.onrender.com/v1/media/:path*"
    }
  ]
}
