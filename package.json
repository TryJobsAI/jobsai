{
  "name": "jobsai-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun server.mjs",
    "build": "bun scripts/build.mjs",
    "build:wallet": "vite build --config vite.wallet.config.js",
    "check": "bun scripts/check.mjs",
    "push:origin": "git push origin main",
    "push:public": "python3 scripts/sync-public.py",
    "push:all": "bun run push:origin && bun run push:public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5",
    "react": "^19",
    "react-dom": "^19",
    "viem": "^2",
    "wagmi": "^2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "vite": "^6"
  }
}
